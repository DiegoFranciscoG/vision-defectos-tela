# Copy to .env and fill in the values. .env is never committed.
# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL password for docker compose (local only).
POSTGRES_PASSWORD=
# Comma-separated API keys accepted by the API (each >= 32 characters).
API_KEYS=
# Key used by the Streamlit demo; must be one of API_KEYS.
DEMO_API_KEY=

# Optional. Local runs without Docker use SQLite by default.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
CORS_ALLOWED_ORIGINS=
ENABLE_DOCS=true

# Quality decision (documented assumptions S1 and S3).
MM_PER_PIXEL=0.1
MAX_POINTS_PER_100_SQ_YD=40

# Optional override of the release URL used to download the ONNX models.
MODEL_BASE_URL=
